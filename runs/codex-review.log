73:class ReplayBuffer:
74:    """Ring buffer of positions held on the CPU (pinned) with a fixed capacity."""
75:
76:    FIELDS = ("cells", "macro", "next_board", "player", "policy", "value", "ownership", "ply")
77:
78:    def __init__(self, capacity: int) -> None:
79:        self.capacity = capacity
80:        self.size = 0
81:        self.pos = 0
82:        self.buf = {
83:            "cells": torch.zeros(capacity, 81, dtype=torch.int8),
84:            "macro": torch.zeros(capacity, 9, dtype=torch.int8),
85:            "next_board": torch.zeros(capacity, dtype=torch.int8),
86:            "player": torch.zeros(capacity, dtype=torch.int8),
87:            "policy": torch.zeros(capacity, 81, dtype=torch.float16),
88:            "value": torch.zeros(capacity, dtype=torch.int8),
89:            "ownership": torch.zeros(capacity, 9, dtype=torch.int8),
90:            "ply": torch.zeros(capacity, dtype=torch.int16),
91:        }
92:
93:    def add(self, b: SelfPlayBatch) -> None:
94:        m = len(b)
95:        idx = (torch.arange(m) + self.pos) % self.capacity
96:        for k in self.FIELDS:
97:            self.buf[k][idx] = getattr(b, k).cpu()
98:        self.pos = (self.pos + m) % self.capacity
99:        self.size = min(self.size + m, self.capacity)
100:
101:    def sample(self, batch_size: int, device):
102:        idx = torch.randint(0, self.size, (batch_size,))
103:        return {k: self.buf[k][idx].to(device, non_blocking=True) for k in self.FIELDS}
104:
105:    def state_dict(self):
106:        return {"size": self.size, "pos": self.pos, "buf": {k: v[: self.size] for k, v in self.buf.items()}}
107:
108:    def load_state_dict(self, sd) -> None:
109:        n = sd["size"]
110:        for k in self.FIELDS:
111:            self.buf[k][:n] = sd["buf"][k]
112:        self.size, self.pos = n, sd["pos"] % self.capacity

