2:from __future__ import annotations
3:
4:from dataclasses import dataclass
5:
6:import torch
7:
8:from dataclasses import asdict
9:
10:from .batch import BatchUTTT
11:from .mcts import MCTSConfig
12:from .search import BatchedSearch, SearchConfig
13:
14:
15:@dataclass
16:class MatchResult:
17:    wins: int
18:    draws: int
19:    losses: int
20:
21:    @property
22:    def n(self) -> int:
23:        return self.wins + self.draws + self.losses
24:
25:    @property
26:    def score(self) -> float:
27:        return (self.wins + 0.5 * self.draws) / max(self.n, 1)
28:
29:    def __str__(self) -> str:
30:        return f"+{self.wins} ={self.draws} -{self.losses} ({100 * self.score:.1f}%)"
31:
32:    def __add__(self, o: "MatchResult") -> "MatchResult":
33:        return MatchResult(self.wins + o.wins, self.draws + o.draws, self.losses + o.losses)
34:
35:
36:class RandomPlayer:
37:    """Uniform random mover (not an evaluator; used directly by play_games)."""
38:
39:    def __init__(self, device) -> None:
40:        self.device = device
41:
42:    def act(self, g: BatchUTTT) -> torch.Tensor:
43:        m = g.legal_mask().float() + 1e-9
44:        return torch.multinomial(m, 1).squeeze(1)
45:
46:
47:class SearchPlayer:
48:    """Search-based player (v2 search; a plain MCTSConfig is upgraded to SearchConfig)."""
49:
50:    def __init__(self, evaluator, n: int, cfg: MCTSConfig, device) -> None:
51:        if not isinstance(cfg, SearchConfig):
52:            cfg = SearchConfig(**asdict(cfg))
53:        self.mcts = BatchedSearch(evaluator, n, cfg, device)
54:
55:    def act(self, g: BatchUTTT) -> torch.Tensor:
56:        return self.mcts.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=False).action
57:
58:
59:@torch.no_grad()
60:def play_games(px, po, n: int, device, opening_random_plies: int = 0) -> MatchResult:
61:    """n lock-step games with px moving as X and po as O. Result from X's perspective.
62:
63:    opening_random_plies > 0 randomises the first plies so deterministic players
64:    do not replay one identical game n times.
65:    """
66:    g = BatchUTTT(n, device)
67:    rnd = RandomPlayer(device)
68:    ply = 0
69:    while not bool(g.done.all()):
70:        if ply < opening_random_plies:
71:            moves = rnd.act(g)
72:        else:
73:            moves = (px if ply % 2 == 0 else po).act(g)
74:        g.step(moves)
75:        ply += 1
76:    w = int((g.winner == 1).sum())
77:    l = int((g.winner == -1).sum())
78:    return MatchResult(w, n - w - l, l)
79:
80:
81:def match(pa_factory, pb_factory, n: int, device, opening_random_plies: int = 2) -> MatchResult:
82:    """Side-swapped match: A vs B with n games each way. Result from A's perspective."""
83:    r1 = play_games(pa_factory(), pb_factory(), n, device, opening_random_plies)
84:    r2 = play_games(pb_factory(), pa_factory(), n, device, opening_random_plies)
85:    return r1 + MatchResult(r2.losses, r2.draws, r2.wins)

