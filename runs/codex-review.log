121:        self.macro[mask] = 0
122:        self.next_board[mask] = -1
123:        self.player[mask] = 1
124:        self.move_count[mask] = 0
125:        self.done[mask] = False
126:        self.winner[mask] = 0
127:        self.end_reason[mask] = 0
128:
129:    def state_tuple(self):
130:        return self.cells, self.macro, self.next_board, self.player, self.done
131:
132:    # ---- rules -----------------------------------------------------------
133:    def legal_mask(self) -> torch.Tensor:
134:        return legal_mask(self.cells, self.macro, self.next_board, self.done)
135:
136:    def step(self, moves: torch.Tensor) -> None:
137:        """Apply one move per game (long tensor, shape (n,)). Finished games are untouched."""
138:        active = ~self.done
139:        out = step_state(self.cells, self.macro, self.next_board, self.player, self.done, self.winner, moves)
140:        self.cells, self.macro, self.next_board, self.player, self.done, self.winner, reason = out
141:        self.move_count += active.to(torch.int16)
142:        self.end_reason = torch.where(active & self.done, reason, self.end_reason)
143:
144:    def observation(self) -> torch.Tensor:
145:        return encode(self.cells, self.macro, self.next_board, self.player, self.done)
