# big / regenerable artifacts stay out; code, docs, suites, configs, logs, small results and
# the final checkpoint of every run (the anchors) are tracked.
.venv/
__pycache__/
*.pyc
.sol-*
runs/**
!runs/*/
!runs/*.sh
!runs/*.out
!runs/*.json
!runs/*.log
!runs/*.md
!runs/*/config*.json
!runs/*/log.jsonl
!runs/*/*.out
!runs/*/paired_*.json
!runs/*/timeline.json
!runs/*/timeline.png
!runs/*/probes.json
!runs/*/probes_mlp.json
!runs/*/probes.png
!runs/*/value_decomp.json
!runs/*/value_decomp.png
!runs/*/net_0150.pt
!runs/*/net_0200.pt
!runs/*/net_0300.pt
!runs/*.vbs
!runs/*.cmd
.claude/scheduled_tasks.lock
docs/history/review_astra/numba_cache/
!runs/*/*.sh
!runs/*/eval_full.jsonl
