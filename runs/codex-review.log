1:"""Symmetry-averaged evaluation: evaluate all 8 D4 images of each position and average the
2:mapped-back policies and values. 8x the inference cost; for analysis and evaluation only.
3:
4:The result is exactly equivariant: evaluating a transformed position gives the transformed policy.
5:"""
6:from __future__ import annotations
7:
8:import torch
9:
10:from .batch import SYM_BOARD, SYM_BOARD_INV, SYM_CELL, SYM_CELL_INV
11:
12:
13:class SymmetryAveragedEvaluator:
14:    def __init__(self, base) -> None:
15:        self.base = base
16:        self.device = base.device
17:        d = self.device
18:        self.cell_inv = SYM_CELL_INV.to(d)  # (8, 81)
19:        self.cell = SYM_CELL.to(d)
20:        self.board_inv = SYM_BOARD_INV.to(d)  # (8, 9)
21:        self.board = SYM_BOARD.to(d)
22:
23:    @torch.no_grad()
24:    def __call__(self, cells, macro, next_board, player, done):
25:        n = cells.shape[0]
26:        # images: for symmetry s, new_cells[SYM_CELL[s][m]] = cells[m]  <=>  new_cells = cells[:, SYM_CELL_INV[s]]
27:        c8 = cells[:, self.cell_inv].reshape(n * 8, 81)  # (n, 8, 81) -> (n*8, 81)
28:        m8 = macro[:, self.board_inv].reshape(n * 8, 9)
29:        nb = next_board.long()
30:        nb8 = torch.where(nb.unsqueeze(1) >= 0, self.board[:, nb.clamp(min=0)].t(), nb.unsqueeze(1)).reshape(n * 8).to(next_board.dtype)
31:        p8 = player.repeat_interleave(8)
32:        d8 = done.repeat_interleave(8)
33:        probs, value = self.base(c8, m8, nb8, p8, d8)
34:        probs = probs.view(n, 8, 81)
35:        # map policies back: original move m corresponds to image move SYM_CELL[s][m]
36:        back = torch.gather(probs, 2, self.cell.unsqueeze(0).expand(n, 8, 81))
37:        return back.mean(1), value.view(n, 8).mean(1)

