58:def table_of_considered_visits(m: int, n_sims: int) -> torch.Tensor:
59:    """(m+1, n_sims) table: row k = Sequential-Halving visit schedule for k considered actions."""
60:    table = torch.zeros(m + 1, n_sims, dtype=torch.long)
61:    for k in range(1, m + 1):
62:        if k <= 1:
63:            seq = list(range(n_sims))
64:        else:
65:            log2max = int(math.ceil(math.log2(k)))
66:            seq, visits, num = [], [0] * k, k
67:            while len(seq) < n_sims:
68:                extra = max(1, int(n_sims / (log2max * num)))
69:                for _ in range(extra):
70:                    seq.extend(visits[:num])
71:                    for i in range(num):
72:                        visits[i] += 1
73:                num = max(2, num // 2)
74:        table[k] = torch.tensor(seq[:n_sims])
75:    return table
76:
77:
78:class BatchedMCTS:
79:    def __init__(self, evaluator, n: int, cfg: MCTSConfig, device) -> None:
80:        self.eval = evaluator
81:        self.n = n
82:        self.cfg = cfg
83:        self.device = torch.device(device)
84:        d = self.device
85:        M = cfg.n_sims + 1
86:        self.M = M
87:        self.idx = torch.arange(n, device=d)
88:        self.s_cells = torch.zeros(n, M, 81, dtype=torch.int8, device=d)
89:        self.s_macro = torch.zeros(n, M, 9, dtype=torch.int8, device=d)
90:        self.s_next = torch.zeros(n, M, dtype=torch.int8, device=d)
91:        self.s_player = torch.zeros(n, M, dtype=torch.int8, device=d)
92:        self.s_done = torch.zeros(n, M, dtype=torch.bool, device=d)
93:        self.s_winner = torch.zeros(n, M, dtype=torch.int8, device=d)
94:        self.s_legal = torch.zeros(n, M, 81, dtype=torch.bool, device=d)
95:        self.s_value = torch.zeros(n, M, dtype=torch.float32, device=d)  # network value at node
96:        self.prior = torch.zeros(n, M, 81, dtype=torch.float32, device=d)
97:        self.children = torch.full((n, M, 81), -1, dtype=torch.long, device=d)
98:        self.visit = torch.zeros(n, M, dtype=torch.float32, device=d)
99:        self.value_sum = torch.zeros(n, M, dtype=torch.float32, device=d)
100:        self.table = table_of_considered_visits(cfg.m_considered, cfg.n_sims).to(d)
101:
102:    def _reset(self) -> None:
103:        self.children.fill_(-1)
104:        self.visit.zero_()
105:        self.value_sum.zero_()
106:        self.prior.zero_()
107:        self.s_done.zero_()
108:
109:    def _put(self, slot, mask, cells, macro, nb, player, done, winner, prior, value) -> None:
110:        self.s_cells[mask, slot] = cells[mask]
111:        self.s_macro[mask, slot] = macro[mask]
112:        self.s_next[mask, slot] = nb[mask]
113:        self.s_player[mask, slot] = player[mask]
114:        self.s_done[mask, slot] = done[mask]
115:        self.s_winner[mask, slot] = winner[mask]
116:        self.s_legal[mask, slot] = legal_mask(cells, macro, nb, done)[mask]
117:        self.prior[mask, slot] = prior[mask]
118:        self.s_value[mask, slot] = value[mask]
119:
120:    # ---- child statistics for a batch of nodes -----------------------------
121:    def _child_stats(self, node):
122:        ch = self.children[self.idx, node]
123:        has = ch >= 0
124:        chc = ch.clamp(min=0)
125:        zeros = torch.zeros_like(self.prior[:, 0])
126:        Nc = torch.where(has, self.visit.gather(1, chc), zeros)
127:        Wc = torch.where(has, self.value_sum.gather(1, chc), zeros)
128:        Qc = torch.where(Nc > 0, -Wc / Nc.clamp(min=1), zeros)  # from this node's perspective
129:        return ch, Nc, Qc
130:
131:    def _completed_q_sigma(self, node, P, legal, Nc, Qc):
132:        """mctx qtransform_completed_by_mix_value: sigma(completed q) rescaled to [0,1]."""
133:        cfg = self.cfg
134:        visited = Nc > 0
135:        sum_visits = Nc.sum(1)
136:        sum_probs = (P * visited).sum(1)
137:        weighted_q = (P * Qc * visited).sum(1) / torch.where(sum_probs > 0, sum_probs, torch.ones_like(sum_probs))
138:        raw = self.s_value[self.idx, node]
139:        v_mix = (raw + sum_visits * weighted_q) / (sum_visits + 1)
140:        completed = torch.where(visited, Qc, v_mix.unsqueeze(1))
141:        big = torch.finfo(torch.float32).max
142:        lo = torch.where(legal, completed, torch.full_like(completed, big)).min(1, keepdim=True).values
143:        hi = torch.where(legal, completed, torch.full_like(completed, -big)).max(1, keepdim=True).values
144:        qn = (completed - lo) / (hi - lo).clamp(min=1e-6)
145:        return (cfg.c_visit + Nc.max(1, keepdim=True).values) * cfg.c_scale * qn
146:
147:    @torch.no_grad()
148:    def search(self, cells, macro, next_board, player, done, winner, selfplay: bool, ply: int = 0) -> SearchResult:
149:        cfg, n, idx, d = self.cfg, self.n, self.idx, self.device
150:        gumbel = cfg.mode == "gumbel"
151:        self._reset()
152:        all_mask = torch.ones(n, dtype=torch.bool, device=d)
