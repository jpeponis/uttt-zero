1:"""Continuous self-play (v2): n games run in parallel indefinitely; a finished game is
2:flushed to the output and reset in place, so no simulation is spent on a lock-step tail.
3:
4:Per position we keep: state, policy target, search root value, ply; and, once the
5:game ends: result z, final local-board ownership, and the won-board margin, all from
6:the side-to-move's perspective. Every finished game's move sequence is returned so
7:it can be persisted (tools/corpus_stats.py reads those files).
8:
9:Also here: GPUReplayBuffer — a ring buffer on the GPU with a 64-bit position hash,
10:so identical positions (the opening plies) can be down-weighted at sampling time.
11:"""
12:from __future__ import annotations
13:
14:from dataclasses import dataclass, field
15:
16:import numpy as np
17:import torch
18:
19:from .batch import BatchUTTT
20:from .search import BatchedSearch, SearchConfig
21:
22:MAX_PLY = 82
23:POS_FIELDS = ("cells", "macro", "next_board", "player", "policy", "value", "ownership", "margin", "root_value", "ply", "hash")
24:
25:
26:def position_hash(cells, next_board, player) -> torch.Tensor:
27:    """64-bit hash of (cells, next_board, player); collisions are negligible for our buffer sizes."""
28:    d = cells.device
29:    gen = torch.Generator(device="cpu").manual_seed(12345)
30:    coef = torch.randint(-(2**62), 2**62, (83,), generator=gen).to(d)
31:    x = torch.cat([cells.long() + 1, next_board.long().unsqueeze(1) + 2, player.long().unsqueeze(1) + 2], dim=1)
32:    return (x * coef).sum(1)  # wraps mod 2^64
