24:def orbits():
25:    seen, out = set(), []
26:    for m in range(81):
27:        if m in seen:
28:            continue
29:        orb = sorted({int(SYM_CELL[s, m]) for s in range(8)})
30:        seen.update(orb)
31:        out.append(orb)
32:    return out
