40:def load_positions(buffer_path, device, n_max, ply_lo, ply_hi, seed=0):
41:    ck = torch.load(buffer_path, map_location="cpu", weights_only=False)
42:    b = ck["buffer"]["buf"]
43:    ply = b["ply"].long()
44:    keep = torch.nonzero((ply >= ply_lo) & (ply <= ply_hi)).squeeze(1)
45:    g = torch.Generator().manual_seed(seed)
46:    keep = keep[torch.randperm(len(keep), generator=g)[:n_max]]
47:    out = {k: b[k][keep].to(device) for k in ("cells", "macro", "next_board", "player", "ply")}
48:    # deduplicate identical positions
49:    _, first = torch.unique(torch.cat([out["cells"], out["macro"], out["next_board"].unsqueeze(1), out["player"].unsqueeze(1)], 1).long(), dim=0, return_inverse=True)
50:    sel = torch.unique(first)
51:    return {k: v[sel] for k, v in out.items()}
