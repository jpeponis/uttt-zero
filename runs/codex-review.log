25:            mod.c2 = fuse_conv_bn_eval(mod.c2, mod.b2)
26:            mod.b2 = nn.Identity()
27:        elif isinstance(mod, nn.Sequential) and len(mod) >= 2 and isinstance(mod[0], nn.Conv2d) and isinstance(mod[1], nn.BatchNorm2d):
28:            mod[0] = fuse_conv_bn_eval(mod[0], mod[1])
29:            mod[1] = nn.Identity()
30:    return m
