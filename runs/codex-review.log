48:def build(cfg: TrainConfig):
49:    net = ResNet(NetConfig(blocks=cfg.blocks, filters=cfg.filters))
50:    opt = torch.optim.SGD(net.parameters(), lr=cfg.lr, momentum=cfg.momentum, weight_decay=cfg.wd, nesterov=True)
51:    return net, opt
52:
53:
54:def train_steps(net, opt, scaler, buf: ReplayBuffer, cfg: TrainConfig, n_steps: int, device):
55:    net.train()
56:    tot = {"policy": 0.0, "value": 0.0, "own": 0.0, "acc_v": 0.0, "acc_p": 0.0}
57:    for _ in range(n_steps):
58:        b = buf.sample(cfg.batch, device)
59:        s = int(torch.randint(0, 8, (1,)))
60:        cells, macro, nb, pol = apply_symmetry(s, b["cells"], b["macro"], b["next_board"], b["policy"].float())
61:        from .batch import SYM_BOARD_INV
62:        own = b["ownership"][:, SYM_BOARD_INV[s].to(device)]
63:        obs = encode(cells, macro, nb, b["player"])
64:        with torch.autocast("cuda", dtype=torch.float16):
65:            p_logits, v_logits, o_logits, _ = net(obs)
66:        p_logits = p_logits.float()
67:        from .batch import INV_PERM
68:        p_logits = p_logits[:, INV_PERM.to(device)]  # engine order to match targets
69:        logp = torch.log_softmax(p_logits, dim=1)
70:        loss_p = -(pol * logp).sum(1).mean()
71:        v_target = (1 - b["value"].long()).clamp(0, 2)  # +1 -> 0 (win), 0 -> 1 (draw), -1 -> 2 (loss)
72:        loss_v = F.cross_entropy(v_logits.float(), v_target)
73:        o_target = (1 - own.long()).clamp(0, 2)
74:        loss_o = F.cross_entropy(o_logits.float().reshape(-1, 3), o_target.reshape(-1))
75:        loss = loss_p + cfg.value_weight * loss_v + cfg.own_weight * loss_o
76:        opt.zero_grad(set_to_none=True)
77:        scaler.scale(loss).backward()
78:        scaler.step(opt)
79:        scaler.update()
80:        tot["policy"] += float(loss_p)
81:        tot["value"] += float(loss_v)
82:        tot["own"] += float(loss_o)
83:        tot["acc_v"] += float((v_logits.argmax(1) == v_target).float().mean())
84:        tot["acc_p"] += float((p_logits.argmax(1) == pol.argmax(1)).float().mean())
85:    net.eval()
86:    return {k: v / n_steps for k, v in tot.items()}
