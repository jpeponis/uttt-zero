68:    solve(np.zeros(81, np.int8), np.array([1, 1, 2, -1, -1, 2, 2, 2, 0], np.int8), -1, 1)  # JIT warm-up on a tiny case
69:    test_against_reference()
70:    test_speed()
71:    print("ok")

