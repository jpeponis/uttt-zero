159:class GPUReplayBuffer:
160:    """Ring buffer on the GPU. sample() draws ∝ weight, where weight = count^-alpha of identical positions."""
161:
162:    def __init__(self, capacity: int, device) -> None:
163:        self.capacity = capacity
164:        self.device = torch.device(device)
165:        d = self.device
166:        self.size = 0
167:        self.pos = 0
168:        z = lambda *shape, dtype: torch.zeros(*shape, dtype=dtype, device=d)  # noqa: E731
169:        self.buf = {
170:            "cells": z(capacity, 81, dtype=torch.int8), "macro": z(capacity, 9, dtype=torch.int8),
171:            "next_board": z(capacity, dtype=torch.int8), "player": z(capacity, dtype=torch.int8),
172:            "policy": z(capacity, 81, dtype=torch.float16), "value": z(capacity, dtype=torch.int8),
173:            "ownership": z(capacity, 9, dtype=torch.int8), "margin": z(capacity, dtype=torch.int8),
174:            "root_value": z(capacity, dtype=torch.float16), "ply": z(capacity, dtype=torch.int16),
175:            "hash": z(capacity, dtype=torch.int64),
176:        }
177:        self.weights = torch.ones(capacity, device=d)
178:        self.dup_stats = {}
179:
180:    def add(self, positions: dict) -> int:
181:        m = int(positions["cells"].shape[0])
182:        if m == 0:
183:            return 0
184:        idx = (torch.arange(m, device=self.device) + self.pos) % self.capacity
185:        for k in POS_FIELDS:
186:            self.buf[k][idx] = positions[k].to(self.buf[k].dtype)
187:        self.pos = (self.pos + m) % self.capacity
188:        self.size = min(self.size + m, self.capacity)
189:        return m
190:
191:    def update_weights(self, alpha: float = 0.5) -> dict:
192:        """Recompute sampling weights = count^-alpha over identical positions; returns duplication stats."""
193:        if self.size == 0:
194:            self.dup_stats = {}
195:            return {}
196:        h = self.buf["hash"][: self.size]
197:        _, inv, counts = torch.unique(h, return_inverse=True, return_counts=True)
198:        c = counts[inv].float()
199:        self.weights[: self.size] = c.pow(-alpha) if alpha > 0 else 1.0
200:        ply = self.buf["ply"][: self.size]
201:        stats = {"distinct_frac": round(float(counts.numel() / self.size), 3)}
202:        for p in (0, 2, 4, 8, 12):
203:            m = ply == p
204:            if m.any():
205:                stats[f"dup_mean_ply{p}"] = round(float(c[m].mean()), 1)
206:        self.dup_stats = stats
207:        return stats
208:
209:    def sample(self, batch_size: int) -> dict:
210:        idx = torch.multinomial(self.weights[: self.size], batch_size, replacement=True)
211:        return {k: self.buf[k][idx] for k in POS_FIELDS}
212:
213:    def state_dict(self) -> dict:
214:        return {"size": self.size, "pos": self.pos, "buf": {k: v[: self.size].cpu() for k, v in self.buf.items()}}
215:
216:    def load_state_dict(self, sd: dict) -> None:
217:        n = min(sd["size"], self.capacity)
218:        for k in POS_FIELDS:
219:            self.buf[k][:n] = sd["buf"][k][:n].to(self.device)
220:        self.size, self.pos = n, sd["pos"] % self.capacity
221:        self.update_weights()

