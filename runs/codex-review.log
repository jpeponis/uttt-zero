147:
148:# ---- functional forms (usable on stored replay / tree states) --------------
149:def step_state(cells, macro, next_board, player, done, winner, moves):
150:    """Pure batched rules step. Returns new (cells, macro, next_board, player, done, winner, reason).
151:
152:    reason is 0 unless the game ended on this step (1 line, 2 count, 3 draw).
153:    Games with done=True are returned unchanged.
154:    """
155:    n = cells.shape[0]
156:    d = cells.device
157:    idx = torch.arange(n, device=d)
158:    lines = consts(d)["LINES"]
159:    active = ~done
160:    moves = moves.long()
161:    b = moves // 9
162:    c = moves % 9
163:    p = player
164:
165:    cells = cells.clone()
166:    macro = macro.clone()
167:    cells[idx, moves] = torch.where(active, p, cells[idx, moves])  # no boolean indexing: no host sync
168:
169:    local = cells.view(n, 9, 9)[idx, b]  # (n, 9)
170:    won = (local[:, lines] == p.view(n, 1, 1)).all(-1).any(-1)
171:    full = (local != 0).all(-1)
172:    status = torch.where(won, p, torch.where(full, torch.full_like(p, FULL), torch.zeros_like(p)))
173:    macro[idx, b] = torch.where(active, status, macro[idx, b])
174:
175:    won_only = macro * (macro.abs() == 1)
176:    mline = (won_only[:, lines] == p.view(n, 1, 1)).all(-1).any(-1)
177:    all_closed = (macro != 0).all(1)
178:    diff = (macro == 1).sum(1) - (macro == -1).sum(1)
179:    count_winner = torch.sign(diff).to(torch.int8)
180:    newly_done = active & (mline | all_closed)
181:    winner = torch.where(newly_done, torch.where(mline, p, count_winner), winner)
182:    reason = torch.where(mline, 1, torch.where(count_winner != 0, 2, 3)).to(torch.int8)
183:    reason = torch.where(newly_done, reason, torch.zeros_like(reason))
184:    done = done | newly_done
185:
186:    target_closed = macro[idx, c] != 0
187:    nb = torch.where(target_closed, torch.full_like(c, -1), c).to(torch.int8)
188:    next_board = torch.where(active, nb, next_board)
189:    player = torch.where(active, -p, p)
190:    return cells, macro, next_board, player, done, winner, reason
191:
192:
193:def terminal_value(winner, player, done) -> torch.Tensor:
194:    """Game value in [-1, 1] from the side-to-move's perspective; 0 for ongoing games."""
195:    return torch.where(done, (winner * player).float(), torch.zeros(winner.shape, device=winner.device))
196:def legal_mask(cells, macro, next_board, done=None) -> torch.Tensor:
197:    open_board = macro == 0  # (n, 9)
198:    nb = next_board.long()
199:    nb0 = nb.clamp(min=0)
200:    sent_open = (nb >= 0) & open_board.gather(1, nb0.unsqueeze(1)).squeeze(1)
201:    one_hot = F.one_hot(nb0, 9).bool()
202:    allowed = torch.where(sent_open.unsqueeze(1), one_hot, open_board)
203:    mask = (cells == 0) & allowed.repeat_interleave(9, dim=1)
204:    if done is not None:
205:        mask = mask & ~done.unsqueeze(1)
206:    return mask
207:
208:
209:def encode(cells, macro, next_board, player, done=None) -> torch.Tensor:
210:    """(n, N_PLANES, 9, 9) float32 planes from the side-to-move's perspective, grid order.
211:
212:    0 own stones, 1 opponent stones, 2 boards won by self, 3 boards won by
213:    opponent, 4 boards closed full/drawn, 5 legal-move mask, 6 all ones.
214:    """
215:    n = cells.shape[0]
216:    c = consts(cells.device)
217:    perm = c["PERM"]
218:    bog = c["BOARD_OF_GRID"]
219:    p = player.view(n, 1)
220:    grid = cells[:, perm]
221:    mg = macro[:, bog]
222:    legal = legal_mask(cells, macro, next_board, done)[:, perm]
223:    planes = torch.stack(
224:        [grid == p, grid == -p, mg == p, mg == -p, mg == FULL, legal, torch.ones_like(legal)], dim=1
225:    )
226:    return planes.view(n, N_PLANES, 9, 9).float()
227:
228:
229:def apply_symmetry(s: int, cells, macro, next_board, policy=None):
230:    """Return the state (and optional policy over 81 engine-order moves) transformed by symmetry s.
231:
232:    Convention: new_cells[SYM_CELL[s][m]] = cells[m], i.e. a stone on m moves to its image.
233:    """
234:    c = consts(cells.device)
235:    cp = c["SYM_CELL_INV"][s]
236:    bp = c["SYM_BOARD_INV"][s]
237:    new_cells = cells[:, cp]
238:    new_macro = macro[:, bp]
239:    sb = c["SYM_BOARD"][s]
240:    new_next = torch.where(next_board >= 0, sb[next_board.long().clamp(min=0)].to(next_board.dtype), next_board)
241:    if policy is None:
242:        return new_cells, new_macro, new_next
243:    return new_cells, new_macro, new_next, policy[:, cp]

