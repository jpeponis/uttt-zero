92:                    free_by_x[k] += 1
93:            g.play(int(moves[k, t]))
94:        closed_at_end[k] = int((g.macro != 0).sum())
95:    w = win[:R]
96:    print(f"\nfree moves per game (replayed {R}): mean {free_moves.mean():.2f}; games with >=1 free move {100 * (free_moves > 0).mean():.1f}%")
97:    fx = free_by_x - (free_moves - free_by_x)
