1:"""Reference (single-game, pure Python/numpy) implementation of Ultimate Tic-Tac-Toe.
2:
3:Rule set (the "closed board" variant with most-boards tiebreak, as on CodinGame):
4:
5:* Nine local 3x3 boards sit in a 3x3 macro grid. Move index m = 9*board + cell,
6:  board = 3*R + C and cell = 3*r + c, both row-major.
7:* Playing cell k of any board sends the opponent to board k.
8:* A local board is CLOSED once it is won or full; no move may be played in it.
9:* If the designated board is closed, the player may play in ANY open board.
10:* Three won local boards in a macro line win the game immediately.
11:* If no legal move remains (every board closed) with no macro line, the player
12:  with MORE won local boards wins; equal counts is a draw.
13:
14:Players are +1 (X, moves first) and -1 (O). A local board's macro status is
15:0 open, +1/-1 won, 2 closed-as-full-without-winner.
16:"""
17:from __future__ import annotations
18:
19:import numpy as np
20:
21:LINES = np.array(
22:    [(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6), (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)],
23:    dtype=np.int64,
24:)
25:FULL = 2  # macro marker for a drawn (full, unwon) local board
26:
27:
28:def line_winner(cells9: np.ndarray) -> int:
29:    """Winner (+1/-1) of a length-9 array under standard tic-tac-toe lines, else 0."""
30:    for a, b, c in LINES:
31:        v = cells9[a]
32:        if v != 0 and v == cells9[b] == cells9[c]:
33:            return int(v)
34:    return 0
35:
36:
37:class UTTT:
38:    __slots__ = ("cells", "macro", "next_board", "player", "move_count", "done", "winner", "end_reason")
39:
40:    def __init__(self) -> None:
41:        self.cells = np.zeros(81, dtype=np.int8)
42:        self.macro = np.zeros(9, dtype=np.int8)
43:        self.next_board = -1  # -1 = free move
44:        self.player = 1
45:        self.move_count = 0
46:        self.done = False
47:        self.winner = 0  # +1 / -1, or 0 for draw / ongoing
48:        self.end_reason = ""  # "line" | "count" | "draw" once done
49:
50:    def clone(self) -> "UTTT":
51:        g = UTTT.__new__(UTTT)
52:        g.cells = self.cells.copy()
53:        g.macro = self.macro.copy()
54:        g.next_board = self.next_board
55:        g.player = self.player
56:        g.move_count = self.move_count
57:        g.done = self.done
58:        g.winner = self.winner
59:        g.end_reason = self.end_reason
60:        return g
61:
62:    # ---- rules -----------------------------------------------------------
63:    def legal_mask(self) -> np.ndarray:
64:        if self.done:
65:            return np.zeros(81, dtype=bool)
66:        open_board = self.macro == 0
67:        if self.next_board >= 0 and open_board[self.next_board]:
68:            allowed = np.zeros(9, dtype=bool)
69:            allowed[self.next_board] = True
70:        else:
71:            allowed = open_board
72:        return (self.cells == 0) & np.repeat(allowed, 9)
73:
74:    def legal_moves(self) -> list[int]:
75:        return np.flatnonzero(self.legal_mask()).tolist()
76:
77:    def play(self, move: int) -> None:
78:        if self.done:
79:            raise ValueError("game is over")
80:        if not self.legal_mask()[move]:
81:            raise ValueError(f"illegal move {move}")
82:        b, c = divmod(move, 9)
83:        p = self.player
84:        self.cells[move] = p
85:        self.move_count += 1
86:
87:        local = self.cells[9 * b : 9 * b + 9]
88:        if line_winner(local) == p:
89:            self.macro[b] = p
90:        elif np.all(local != 0):
91:            self.macro[b] = FULL
92:
93:        if line_winner(np.where(np.abs(self.macro) == 1, self.macro, 0)) == p:
94:            self.done, self.winner, self.end_reason = True, p, "line"
95:        elif np.all(self.macro != 0):
96:            x, o = int(np.sum(self.macro == 1)), int(np.sum(self.macro == -1))
97:            self.done = True
98:            if x != o:
99:                self.winner, self.end_reason = (1 if x > o else -1), "count"
100:            else:
101:                self.winner, self.end_reason = 0, "draw"
102:
103:        self.next_board = c if self.macro[c] == 0 else -1
104:        self.player = -p
105:
106:    # ---- display ---------------------------------------------------------
107:    def __str__(self) -> str:
108:        sym = {0: ".", 1: "X", -1: "O"}
109:        rows = []
110:        for row in range(9):
111:            R, r = divmod(row, 3)
112:            s = ""
113:            for col in range(9):
114:                C, c = divmod(col, 3)
115:                s += sym[int(self.cells[9 * (3 * R + C) + 3 * r + c])]
116:                s += " " if col % 3 != 2 else ("  " if col < 8 else "")
117:            rows.append(s)
118:            if row in (2, 5):
119:                rows.append("")
120:        msym = {0: ".", 1: "X", -1: "O", 2: "#"}
121:        macro = "\n".join("".join(msym[int(self.macro[3 * R + C])] for C in range(3)) for R in range(3))
122:        nb = self.next_board if self.next_board >= 0 else "any"
123:        head = f"to move: {sym[self.player]}   next board: {nb}   moves: {self.move_count}"
124:        if self.done:
125:            res = "draw" if self.winner == 0 else sym[self.winner] + " wins"
126:            head += f"   RESULT: {res} ({self.end_reason})"
127:        return head + "\n" + "\n".join(rows) + "\nmacro:\n" + macro

