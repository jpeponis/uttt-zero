1:"""Diagnostics for the search loop: CPU->GPU synchronisations and kernel launches per simulation.
2:
3:Runs on cuda:1 (the 3060) with a small batch so it does not disturb a training run on cuda:0.
4:"""
5:import os
6:import sys
7:import warnings
8:
9:import torch
10:
11:sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
12:from uttt.batch import BatchUTTT  # noqa: E402
13:from uttt.mcts import BatchedMCTS, MCTSConfig  # noqa: E402
14:from uttt.model import Evaluator, NetConfig, ResNet, UniformEvaluator  # noqa: E402
15:
16:DEV = "cuda:1" if torch.cuda.device_count() > 1 else "cuda:0"
17:
18:
19:def make(n, sims, net):
20:    g = BatchUTTT(n, DEV)
21:    for _ in range(6):
22:        m = g.legal_mask().float() + 1e-9
23:        g.step(torch.multinomial(m, 1).squeeze(1))
24:    ev = Evaluator(ResNet(NetConfig()), DEV) if net else UniformEvaluator(DEV)
25:    return g, BatchedMCTS(ev, n, MCTSConfig(n_sims=sims, mode="gumbel"), DEV)
26:
27:
28:def count_syncs(n=256, sims=8):
29:    g, mcts = make(n, sims, net=False)
30:    mcts.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=True)  # warm-up
31:    torch.cuda.set_sync_debug_mode("warn")
32:    with warnings.catch_warnings(record=True) as w:
33:        warnings.simplefilter("always")
34:        mcts.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=True)
35:    torch.cuda.set_sync_debug_mode("default")
36:    msgs = [str(x.message) for x in w if "synchroniz" in str(x.message).lower()]
37:    print(f"syncs per search of {sims} sims: {len(msgs)}  -> {len(msgs) / sims:.1f} per simulation")
38:    kinds = {}
39:    for m in msgs:
40:        k = m.split("called a synchronizing operation")[0].strip()[-60:] if "called" in m else m[:60]
41:        kinds[k] = kinds.get(k, 0) + 1
42:    for k, v in sorted(kinds.items(), key=lambda kv: -kv[1])[:8]:
43:        print(f"  {v:4d}  {k}")
44:
45:
46:def count_kernels(n=1024, sims=8, net=True):
47:    from torch.profiler import ProfilerActivity, profile
48:    g, mcts = make(n, sims, net=net)
49:    mcts.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=True)
50:    torch.cuda.synchronize(DEV)
51:    with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
52:        mcts.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=True)
53:        torch.cuda.synchronize(DEV)
54:    evs = prof.key_averages()
55:    n_kernels = sum(e.count for e in evs if e.device_type == torch.autograd.DeviceType.CUDA)
56:    cuda_us = sum(e.self_device_time_total for e in evs if e.device_type == torch.autograd.DeviceType.CUDA)
57:    cpu_us = sum(e.self_cpu_time_total for e in evs)
58:    print(f"{'net' if net else 'uniform'} n={n} sims={sims}: {n_kernels} CUDA kernels ({n_kernels / sims:.0f}/sim), "
59:          f"GPU busy {cuda_us / 1e3:.1f} ms ({cuda_us / 1e3 / sims:.1f}/sim), CPU time {cpu_us / 1e3:.1f} ms ({cpu_us / 1e3 / sims:.1f}/sim)")
60:    top = sorted([e for e in evs if e.device_type == torch.autograd.DeviceType.CUDA], key=lambda e: -e.self_device_time_total)[:6]
61:    for e in top:
62:        print(f"    {e.self_device_time_total / 1e3:7.1f} ms  x{e.count:5d}  {e.key[:70]}")
63:
64:
65:if __name__ == "__main__":
66:    count_syncs()
67:    count_kernels(net=False)
68:    count_kernels(net=True)
1:"""Inference throughput of candidate network sizes on each GPU (positions/sec, batched)."""
2:import os
3:import sys
4:import time
5:
6:import torch
7:
8:sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
9:from uttt.model import NetConfig, ResNet  # noqa: E402
10:
11:
12:def bench(dev, blocks, filters, batch, amp, iters=30):
13:    net = ResNet(NetConfig(blocks=blocks, filters=filters)).to(dev).eval()
14:    x = torch.randn(batch, 7, 9, 9, device=dev)
15:    with torch.no_grad(), torch.autocast("cuda", dtype=torch.float16, enabled=amp):
16:        for _ in range(5):
17:            net(x)
18:        torch.cuda.synchronize(dev)
19:        t = time.perf_counter()
20:        for _ in range(iters):
21:            net(x)
22:        torch.cuda.synchronize(dev)
23:    dt = (time.perf_counter() - t) / iters
24:    params = sum(p.numel() for p in net.parameters())
25:    return dt, batch / dt, params
26:
27:
28:if __name__ == "__main__":
29:    torch.backends.cudnn.benchmark = True
30:    for dev in ["cuda:0", "cuda:1"][: torch.cuda.device_count()]:
31:        print(f"== {torch.cuda.get_device_name(dev)} ({dev})")
32:        for blocks, filters in [(4, 64), (6, 64), (6, 96), (8, 128), (10, 128)]:
33:            for batch in [512, 4096, 16384]:
34:                for amp in [False, True]:
35:                    dt, tput, params = bench(dev, blocks, filters, batch, amp)
36:                    print(f"  {blocks}x{filters} ({params/1e6:.2f}M)  batch {batch:6d}  {'fp16' if amp else 'fp32'}: "
37:                          f"{dt*1000:7.2f} ms/batch  {tput/1e6:6.2f} M pos/s")

