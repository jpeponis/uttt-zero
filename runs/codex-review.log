101:def train_steps(net, opt, scaler, buf: GPUReplayBuffer, cfg: TrainConfig, n_steps: int, device, lr_fn):
102:    net.train()
103:    inv = INV_PERM.to(device)
104:    tot = torch.zeros(6, device=device)
105:    for _ in range(n_steps):
106:        for g in opt.param_groups:
107:            g["lr"] = lr_fn()
108:        b = buf.sample(cfg.batch)
109:        cells, macro, nb, pol, own = symmetrise(b, device)
110:        obs = encode(cells, macro, nb, b["player"])
111:        with torch.autocast("cuda", dtype=torch.float16):
112:            p_logits, v_logits, o_logits, m_logits = net(obs)
113:        p_logits = p_logits.float()[:, inv]
114:        logp = torch.log_softmax(p_logits, dim=1)
115:        loss_p = -(pol * logp).sum(1).mean()
116:        v_target = (1 - b["value"].long()).clamp(0, 2)
117:        loss_v = F.cross_entropy(v_logits.float(), v_target)
118:        o_target = (1 - own.long()).clamp(0, 2)
119:        loss_o = F.cross_entropy(o_logits.float().reshape(-1, 3), o_target.reshape(-1))
120:        m_target = (b["margin"].long() + MARGIN_BINS // 2).clamp(0, MARGIN_BINS - 1)
121:        loss_m = F.cross_entropy(m_logits.float(), m_target)
122:        loss = loss_p + cfg.value_weight * loss_v + cfg.own_weight * loss_o + cfg.margin_weight * loss_m
123:        opt.zero_grad(set_to_none=True)
124:        scaler.scale(loss).backward()
125:        scaler.step(opt)
126:        scaler.update()
127:        tot += torch.stack([loss_p.detach(), loss_v.detach(), loss_o.detach(), loss_m.detach(),
128:                            (v_logits.argmax(1) == v_target).float().mean(), (p_logits.argmax(1) == pol.argmax(1)).float().mean()])
129:    net.eval()
130:    t = (tot / n_steps).tolist()
131:    return dict(zip(("policy", "value", "own", "margin", "acc_v", "acc_p"), [round(x, 4) for x in t]))
