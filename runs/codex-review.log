89:def evaluate(net, cfg: TrainConfig, device, prev_net=None):
90:    n = cfg.eval_games
91:    ev = Evaluator(net, device)
92:    ecfg = MCTSConfig(n_sims=cfg.eval_sims, mode="gumbel", gumbel_scale=0.0)
93:    out = {}
94:    # vs uniform-prior search (plain UCT with the same budget)
95:    uni = UniformEvaluator(device)
96:    r = match(lambda: SearchPlayer(ev, n, ecfg, device), lambda: SearchPlayer(uni, n, ecfg, device), n, device)
97:    out["vs_uct"] = r.score
98:    # raw policy (no search) vs random
99:    ecfg1 = MCTSConfig(n_sims=1, mode="gumbel", gumbel_scale=0.0)
100:    r = play_games(SearchPlayer(ev, n, ecfg1, device), RandomPlayer(device), n, device)
101:    out["policy_vs_random"] = r.score
102:    if prev_net is not None:
103:        pev = Evaluator(prev_net, device)
104:        r = match(lambda: SearchPlayer(ev, n, ecfg, device), lambda: SearchPlayer(pev, n, ecfg, device), n, device)
105:        out["vs_prev"] = r.score
106:    return out
