23:def _win_position(n=8):
24:    """X has boards 0 and 1; sent to board 2 where cells 0,1 are X -> move 9*2+2 wins the game."""
25:    g = BatchUTTT(n, DEV)
26:    g.macro[:, 0] = 1
27:    g.macro[:, 1] = 1
28:    g.cells[:, 9 * 2 + 0] = 1
29:    g.cells[:, 9 * 2 + 1] = 1
30:    g.cells[:, 9 * 2 + 3] = -1
31:    g.cells[:, 9 * 2 + 4] = -1
32:    g.next_board[:] = 2
33:    return g
34:
35:
36:def _block_position(n=8):
37:    """O to move, sent to board 2; X threatens 9*2+2. Boards 4,5,7,8 closed, so every other O
38:    move hands X a free move and an immediate win: the block is forced."""
39:    g = BatchUTTT(n, DEV)
40:    g.macro[:, 0] = 1
41:    g.macro[:, 1] = 1
42:    g.macro[:, 6] = -1
43:    for b in (4, 5, 7, 8):
44:        g.macro[:, b] = FULL
45:    g.cells[:, 9 * 2 + 0] = 1
46:    g.cells[:, 9 * 2 + 1] = 1
47:    g.cells[:, 9 * 2 + 3] = -1
48:    g.cells[:, 9 * 2 + 6] = -1
49:    g.next_board[:] = 2
50:    g.player[:] = -1
51:    return g
