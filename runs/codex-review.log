49:        rec["player"].append(g.player[active])
50:        rec["policy"].append(res.policy[active].half())
51:        rec["ply"].append(torch.full((int(active.sum()),), ply, dtype=torch.int16, device=d))
52:        rec["game_id"].append(torch.nonzero(active).squeeze(1).to(torch.int32))
