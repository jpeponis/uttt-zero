54:def test_tactics():
55:    for cfg in MODES:
56:        for name, g, expect_sign in (("win", _win_position(), 1), ("block", _block_position(), -1)):
57:            mcts = BatchedMCTS(UniformEvaluator(DEV), g.n, cfg, DEV)
58:            for selfplay in (False, True):
59:                r = mcts.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=selfplay)
60:                assert bool((r.policy.argmax(1) == 20).all()), (cfg.mode, name, selfplay, r.visits[0].tolist())
61:                if not (selfplay and cfg.mode == "puct"):  # puct self-play samples the early moves
62:                    assert bool((r.action == 20).all()), (cfg.mode, name, selfplay)
63:            print(f"{cfg.mode:6s} {name:5s}: root value {float(r.root_value.mean()):+.2f}, target p(best) {float(r.policy[0, 20]):.2f}")
