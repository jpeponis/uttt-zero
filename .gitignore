# big / regenerable artifacts stay out; code, docs, suites, configs, logs, small results and
# the final checkpoint of every run (the anchors) are tracked.
.venv/
__pycache__/
*.pyc
.sol-*
runs/**
!runs/*/
!runs/*.sh
!runs/*.out
!runs/*.json
!runs/*.log
!runs/*.md
!runs/*/config*.json
!runs/*/log.jsonl
!runs/*/*.out
!runs/*/paired_*.json
!runs/*/timeline.json
!runs/*/timeline.png
!runs/*/probes.json
!runs/*/probes_mlp.json
!runs/*/probes.png
!runs/*/value_decomp.json
!runs/*/value_decomp.png
!runs/*/net_0150.pt
!runs/*/net_0200.pt
!runs/*/net_0300.pt
!runs/*.vbs
!runs/*.cmd
.claude/scheduled_tasks.lock
docs/history/review_astra/numba_cache/
!runs/*/*.sh
!runs/*/eval_full.jsonl
!runs/plan6/H4_diag/
!runs/plan6/H4_diag/*.py
!runs/plan6/*.json
# outside-review event streams (PLAN7 S7a): REVIEW.md, briefs, launch.ps1, status.txt and stderr.txt
# are tracked; the JSONL stream and the launcher's scratch files are not
docs/reviews/*/events*.jsonl
docs/reviews/*/launcher_*.txt
docs/reviews/*/empty_stdin.txt

# agent worktrees (Claude Code isolation: full copies of the tree under .claude/worktrees/<agent>)
.claude/worktrees/
