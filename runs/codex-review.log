86:def symmetrise(b: dict, device):
87:    """Apply an independent random D4 symmetry to every sample of a sampled batch."""
88:    n = b["cells"].shape[0]
89:    s = torch.randint(0, 8, (n,), device=device)
90:    cp = SYM_CELL_INV.to(device)[s]  # (n, 81)
91:    bp = SYM_BOARD_INV.to(device)[s]  # (n, 9)
92:    cells = b["cells"].gather(1, cp)
93:    macro = b["macro"].gather(1, bp)
94:    policy = b["policy"].float().gather(1, cp)
95:    own = b["ownership"].gather(1, bp)
96:    nb = b["next_board"].long()
97:    nb2 = torch.where(nb >= 0, SYM_BOARD.to(device)[s, nb.clamp(min=0)], nb).to(torch.int8)
98:    return cells, macro, nb2, policy, own
