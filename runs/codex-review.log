32:
33:class FusedEvaluator:
34:    def __init__(self, net: nn.Module, device, half: bool = True, channels_last: bool = True) -> None:
35:        self.device = torch.device(device)
36:        self.half = half and self.device.type == "cuda"
37:        self.channels_last = channels_last
38:        self._inv = INV_PERM.to(self.device)
39:        self.refresh(net)
40:
41:    def refresh(self, net: nn.Module) -> None:
42:        """Re-snapshot the training net. Weights are copied IN PLACE once the module exists,
43:        so CUDA graphs that captured this evaluator keep seeing the current weights."""
44:        m = _fuse(net).to(self.device)
45:        if self.half:
46:            m = m.half()
47:        if self.channels_last:
48:            m = m.to(memory_format=torch.channels_last)
49:        if getattr(self, "net", None) is None:
50:            self.net = m
51:        else:
52:            with torch.no_grad():
53:                for dst, src in zip(self.net.parameters(), m.parameters()):
54:                    dst.copy_(src)
55:                for dst, src in zip(self.net.buffers(), m.buffers()):
56:                    dst.copy_(src)
57:
58:    @torch.no_grad()
59:    def __call__(self, cells, macro, next_board, player, done):
60:        legal = legal_mask(cells, macro, next_board, done)
61:        obs = encode(cells, macro, next_board, player, done)
62:        if self.half:
63:            obs = obs.half()
64:        if self.channels_last:
65:            obs = obs.contiguous(memory_format=torch.channels_last)
66:        p_logits, v_logits, *_ = self.net(obs)
67:        p_logits = p_logits.float()[:, self._inv].masked_fill(~legal, float("-inf"))
68:        probs = torch.nan_to_num(torch.softmax(p_logits, dim=1), nan=0.0)
69:        wdl = torch.softmax(v_logits.float(), dim=1)
70:        return probs, wdl[:, 0] - wdl[:, 2]

