18:def test_consistency(n=256, steps=120, sims=8):
19:    torch.manual_seed(0)
20:    sp = ContinuousSelfPlay(UniformEvaluator(DEV), n, SearchConfig(n_sims=sims, mode="gumbel", sample_moves=6), DEV)
21:    pos, games, stats = sp.run(steps)
22:    G = len(games["winners"])
23:    assert G > 0 and stats.games == G
24:    print("finished games:", stats.summary())
25:    # every finished game replays on the reference engine to the same result
26:    for k in range(G):
27:        ref = UTTT()
28:        L = int(games["lengths"][k])
29:        for t in range(L):
30:            ref.play(int(games["moves"][k, t]))
31:        assert ref.done and ref.winner == int(games["winners"][k]) and ref.move_count == L
