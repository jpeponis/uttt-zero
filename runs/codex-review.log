23:@dataclass
24:class TrainConfig:
25:    run: str = "runs/dev"
26:    iters: int = 50
27:    games: int = 1024  # self-play games per iteration (all in one lock-step batch)
28:    sims: int = 32
29:    mode: str = "gumbel"
30:    blocks: int = 6
31:    filters: int = 64
32:    buffer: int = 2_000_000
33:    batch: int = 1024
34:    lr: float = 0.02
35:    momentum: float = 0.9
36:    wd: float = 1e-4
37:    epochs: float = 1.0  # passes over the NEW positions per iteration (sampled from whole buffer)
38:    min_steps: int = 50
39:    value_weight: float = 1.0
40:    own_weight: float = 0.5
41:    eval_every: int = 5
42:    eval_games: int = 256
43:    eval_sims: int = 64
44:    device: str = "cuda:0"
45:    seed: int = 0
