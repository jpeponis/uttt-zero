1:"""Residual policy/value network for UTTT and evaluator wrappers used by the search.
2:
3:Outputs:
4:  policy logits (n, 81) in GRID order (the evaluator converts to engine order),
5:  value logits  (n, 3)  = win / draw / loss from the side-to-move's perspective,
6:  ownership logits (n, 9, 3) = for each local board (engine order), final status
7:      self-won / neither / opponent-won  (KataGo-style auxiliary target),
8:  margin logits (n, MARGIN_BINS) = final won-board difference (self minus opponent),
9:      bins -9..+9 (the quantity the most-boards tiebreak is decided by).
10:"""
11:from __future__ import annotations
12:
13:from dataclasses import dataclass
14:
15:import torch
16:import torch.nn as nn
17:import torch.nn.functional as F
18:
19:from .batch import INV_PERM, N_PLANES, encode, legal_mask
20:
21:MARGIN_BINS = 19  # won-board margin -9..+9
22:
23:
24:@dataclass
25:class NetConfig:
26:    blocks: int = 6
27:    filters: int = 64
28:    policy_channels: int = 4
29:    value_channels: int = 4
30:    value_hidden: int = 128
31:
32:
33:class ResBlock(nn.Module):
34:    def __init__(self, f: int) -> None:
35:        super().__init__()
36:        self.c1 = nn.Conv2d(f, f, 3, padding=1, bias=False)
37:        self.b1 = nn.BatchNorm2d(f)
38:        self.c2 = nn.Conv2d(f, f, 3, padding=1, bias=False)
39:        self.b2 = nn.BatchNorm2d(f)
40:
41:    def forward(self, x):
42:        y = F.relu(self.b1(self.c1(x)))
43:        y = self.b2(self.c2(y))
44:        return F.relu(x + y)
45:
46:
47:class ResNet(nn.Module):
48:    def __init__(self, cfg: NetConfig = NetConfig()) -> None:
49:        super().__init__()
50:        self.cfg = cfg
51:        f = cfg.filters
52:        self.stem = nn.Sequential(nn.Conv2d(N_PLANES, f, 3, padding=1, bias=False), nn.BatchNorm2d(f), nn.ReLU())
53:        self.blocks = nn.Sequential(*[ResBlock(f) for _ in range(cfg.blocks)])
54:        pc, vc = cfg.policy_channels, cfg.value_channels
55:        self.p_conv = nn.Sequential(nn.Conv2d(f, pc, 1, bias=False), nn.BatchNorm2d(pc), nn.ReLU())
56:        self.p_fc = nn.Linear(pc * 81, 81)
57:        self.v_conv = nn.Sequential(nn.Conv2d(f, vc, 1, bias=False), nn.BatchNorm2d(vc), nn.ReLU())
58:        self.v_fc1 = nn.Linear(vc * 81, cfg.value_hidden)
59:        self.v_fc2 = nn.Linear(cfg.value_hidden, 3)
60:        self.o_fc = nn.Linear(vc * 81, 27)
61:        self.m_fc = nn.Linear(vc * 81, MARGIN_BINS)
62:
63:    def forward(self, x):
64:        h = self.blocks(self.stem(x))
65:        p = self.p_fc(self.p_conv(h).flatten(1))
66:        vh = self.v_conv(h).flatten(1)
67:        v = self.v_fc2(F.relu(self.v_fc1(vh)))
68:        o = self.o_fc(vh).view(-1, 9, 3)
69:        m = self.m_fc(vh)
70:        return p, v, o, m
71:
72:
73:class Evaluator:
74:    """Wraps a network: batched (state) -> (policy probs in engine order, scalar value)."""
75:
76:    def __init__(self, net: nn.Module, device, amp: bool = True) -> None:
77:        self.net = net.to(device).eval()
78:        self.device = torch.device(device)
79:        self.amp = amp and self.device.type == "cuda"
80:        self._inv = INV_PERM.to(device)
81:
82:    @torch.no_grad()
83:    def __call__(self, cells, macro, next_board, player, done):
84:        obs = encode(cells, macro, next_board, player, done)
85:        legal = legal_mask(cells, macro, next_board, done)
86:        with torch.autocast("cuda", dtype=torch.float16, enabled=self.amp):
87:            p_logits, v_logits, *_ = self.net(obs)
88:        p_logits = p_logits.float()[:, self._inv]  # engine order
89:        p_logits = p_logits.masked_fill(~legal, float("-inf"))
90:        probs = torch.softmax(p_logits, dim=1)
91:        probs = torch.nan_to_num(probs, nan=0.0)  # rows with no legal move (finished games)
92:        wdl = torch.softmax(v_logits.float(), dim=1)
93:        value = wdl[:, 0] - wdl[:, 2]
94:        return probs, value
95:
96:
97:class UniformEvaluator:
98:    """Uniform policy over legal moves, value 0 — turns the search into plain UCT for tests."""
99:
100:    def __init__(self, device) -> None:
101:        self.device = torch.device(device)
102:
103:    def __call__(self, cells, macro, next_board, player, done):
104:        legal = legal_mask(cells, macro, next_board, done).float()
105:        probs = legal / legal.sum(1, keepdim=True).clamp(min=1)
106:        return probs, torch.zeros(cells.shape[0], device=cells.device)

