39:    own = pos["ownership"].cpu().numpy()
40:    margin = pos["margin"].cpu().numpy()
41:    assert np.array_equal((own == 1).sum(1) - (own == -1).sum(1), margin)
42:    # margin sign agrees with z for games decided by count
43:    # policy targets are distributions over legal moves
44:    pol = pos["policy"].float()
45:    assert torch.allclose(pol.sum(1), torch.ones_like(pol.sum(1)), atol=1e-2)
46:    # hash is a function of (cells, next_board, player)
