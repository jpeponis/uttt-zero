100:    def _sigma(self, node, P, legal, Nc, Qc):
101:        """mctx qtransform_completed_by_mix_value, rescaled over legal actions."""
102:        cfg = self.cfg
103:        visited = Nc > 0
104:        sum_visits = Nc.sum(1)
105:        sum_probs = (P * visited).sum(1)
106:        weighted_q = (P * Qc * visited).sum(1) / torch.where(sum_probs > 0, sum_probs, torch.ones_like(sum_probs))
