48:    moves, rv, win, reason, length = map(np.concatenate, (moves, rv, win, reason, length))
49:    G = len(win)
50:    print(f"{G} games from {len(files)} files")
51:    if G == 0:
52:        return
53:    print(f"X wins {100 * (win == 1).mean():.1f}%  O wins {100 * (win == -1).mean():.1f}%  draws {100 * (win == 0).mean():.1f}%")
54:    print(f"ended by line {100 * (reason == 1).mean():.1f}%  by count {100 * (reason == 2).mean():.1f}%  equal count {100 * (reason == 3).mean():.1f}%")
55:    print(f"length: mean {length.mean():.1f}  median {np.median(length):.0f}  p10 {np.percentile(length, 10):.0f}  p90 {np.percentile(length, 90):.0f}  max {length.max()}")
56:
57:    print("\nfirst move by symmetry orbit: games, X score (win=1, draw=0.5)")
58:    fm = moves[:, 0].astype(np.int64)
59:    xs = (win == 1) + 0.5 * (win == 0)
60:    rows = []
61:    for orb in orbits():
62:        m = np.isin(fm, orb)
63:        if m.any():
64:            rows.append((int(m.sum()), orb, float(xs[m].mean())))
65:    for cnt, orb, s in sorted(rows, reverse=True):
66:        print(f"  {str(orb):40s} n={cnt:6d}  X score {100 * s:.1f}%")
67:
68:    # root value trajectory: mean value for X (sign-corrected) by ply, split by final result
69:    print("\nmean root value from X's perspective by ply (X wins | O wins | draws):")
70:    T = min(int(length.max()), 81)
71:    signs = np.where(np.arange(T) % 2 == 0, 1.0, -1.0)  # ply parity -> side to move
72:    for p in range(0, T, 6):
73:        vals = rv[:, p].astype(np.float32) * signs[p]
