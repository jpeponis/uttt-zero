60:class ContinuousSelfPlay:
61:    def __init__(self, evaluator, n: int, cfg: SearchConfig, device) -> None:
62:        self.n = n
63:        self.device = torch.device(device)
64:        d = self.device
65:        self.g = BatchUTTT(n, d)
66:        self.search = BatchedSearch(evaluator, n, cfg, d)
67:        self.idx = torch.arange(n, device=d)
68:        self.len = torch.zeros(n, dtype=torch.long, device=d)
69:        self.st_cells = torch.zeros(n, MAX_PLY, 81, dtype=torch.int8, device=d)
70:        self.st_macro = torch.zeros(n, MAX_PLY, 9, dtype=torch.int8, device=d)
71:        self.st_next = torch.zeros(n, MAX_PLY, dtype=torch.int8, device=d)
72:        self.st_player = torch.zeros(n, MAX_PLY, dtype=torch.int8, device=d)
73:        self.st_policy = torch.zeros(n, MAX_PLY, 81, dtype=torch.float16, device=d)
74:        self.st_rootv = torch.zeros(n, MAX_PLY, dtype=torch.float16, device=d)
75:        self.st_moves = torch.zeros(n, MAX_PLY, dtype=torch.int8, device=d)
76:
77:    def set_evaluator(self, evaluator) -> None:
78:        self.search.eval = evaluator
79:
80:    @torch.no_grad()
81:    def run(self, steps: int):
82:        """Advance every game by `steps` moves. Returns (positions dict, games dict, SelfPlayStats).
83:
84:        positions: tensors on the device for every position whose game finished during
85:        these steps (fields in POS_FIELDS). games: numpy arrays moves (G, 82) int8 padded
86:        with -1, root_values (G, 82) f16, winners, reasons, lengths.
87:        """
88:        g, idx, d = self.g, self.idx, self.device
89:        out = {k: [] for k in POS_FIELDS}
90:        games = {"moves": [], "root_values": [], "winners": [], "reasons": [], "lengths": []}
91:        stats = SelfPlayStats()
92:        for _ in range(steps):
93:            res = self.search.search(g.cells, g.macro, g.next_board, g.player, g.done, g.winner, selfplay=True, ply=self.len)
94:            t = self.len
95:            self.st_cells[idx, t] = g.cells
96:            self.st_macro[idx, t] = g.macro
97:            self.st_next[idx, t] = g.next_board
98:            self.st_player[idx, t] = g.player
99:            self.st_policy[idx, t] = res.policy.half()
100:            self.st_rootv[idx, t] = res.root_value.half()
101:            self.st_moves[idx, t] = res.action.to(torch.int8)
102:            stats.surprise += float((res.root_value - res.raw_value).abs().mean())
103:            stats.steps += 1
104:            self.len = t + 1
105:            g.step(res.action)
106:
107:            fin = torch.nonzero(g.done).squeeze(1)
108:            k = int(fin.numel())
109:            if k == 0:
110:                continue
111:            L = self.len[fin]
112:            tt = torch.arange(MAX_PLY, device=d)
113:            m2 = tt.unsqueeze(0) < L.unsqueeze(1)  # (k, MAX_PLY)
114:            gi = fin.unsqueeze(1).expand(-1, MAX_PLY)[m2]
115:            ti = tt.unsqueeze(0).expand(k, -1)[m2]
116:            player = self.st_player[gi, ti]
117:            winner = g.winner[gi]
118:            final_macro = g.macro[gi]
119:            p1 = player.unsqueeze(1)
120:            own = torch.where(final_macro == p1, 1, torch.where(final_macro == -p1, -1, 0)).to(torch.int8)
121:            margin = ((final_macro == 1).sum(1) - (final_macro == -1).sum(1)).to(torch.int8) * player
122:            cells = self.st_cells[gi, ti]
123:            nb = self.st_next[gi, ti]
124:            out["cells"].append(cells)
125:            out["macro"].append(self.st_macro[gi, ti])
126:            out["next_board"].append(nb)
127:            out["player"].append(player)
128:            out["policy"].append(self.st_policy[gi, ti])
129:            out["value"].append((winner * player).to(torch.int8))
130:            out["ownership"].append(own)
131:            out["margin"].append(margin)
132:            out["root_value"].append(self.st_rootv[gi, ti])
133:            out["ply"].append(ti.to(torch.int16))
134:            out["hash"].append(position_hash(cells, nb, player))
135:            # games
136:            mv = torch.where(m2, self.st_moves[fin], torch.full_like(self.st_moves[fin], -1))
137:            games["moves"].append(mv.cpu().numpy())
138:            games["root_values"].append(torch.where(m2, self.st_rootv[fin], torch.zeros_like(self.st_rootv[fin])).cpu().numpy())
139:            w = g.winner[fin]
140:            r = g.end_reason[fin]
141:            games["winners"].append(w.cpu().numpy())
142:            games["reasons"].append(r.cpu().numpy())
143:            games["lengths"].append(L.cpu().numpy())
144:            stats.games += k
145:            stats.x_win += int((w == 1).sum())
146:            stats.o_win += int((w == -1).sum())
147:            stats.draw += int((w == 0).sum())
148:            stats.end_line += int((r == 1).sum())
149:            stats.end_count += int((r == 2).sum())
150:            stats.total_len += int(L.sum())
151:            stats.first_moves.extend(self.st_moves[fin, 0].tolist())
152:            g.reset_where(g.done)
153:            self.len[fin] = 0
154:        positions = {k: (torch.cat(v) if v else None) for k, v in out.items()}
155:        games = {k: (np.concatenate(v) if v else np.zeros((0,) + ((MAX_PLY,) if k in ("moves", "root_values") else ()))) for k, v in games.items()}
156:        return positions, games, stats
