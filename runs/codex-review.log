1:"""Solver correctness: agrees with a pure-Python minimax on the reference engine for small endgames,
2:and with actual game outcomes when the solved value is decisive along the played line."""
3:import os
4:import sys
5:import time
6:
7:import numpy as np
8:
9:sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
10:from uttt.game import UTTT  # noqa: E402
11:from uttt.solver import empties_in_open_boards, solve  # noqa: E402
12:
13:
14:def minimax_ref(g: UTTT) -> int:
15:    if g.done:
16:        return 0 if g.winner == 0 else (1 if g.winner == g.player else -1)
17:    best = -2
18:    for m in g.legal_moves():
19:        h = g.clone()
20:        h.play(m)
21:        v = -minimax_ref(h)
22:        if v > best:
23:            best = v
24:        if best == 1:
25:            break
26:    return best
27:
28:
29:def random_endgame(rng, max_empty):
30:    """Play random moves until the position has <= max_empty empties in open boards (and is not over)."""
31:    while True:
32:        g = UTTT()
33:        while not g.done and empties_in_open_boards(g.cells, g.macro) > max_empty:
34:            g.play(int(rng.choice(g.legal_moves())))
35:        if not g.done:
36:            return g
37:
38:
39:def test_against_reference(n=60, max_empty=8, seed=0):
40:    rng = np.random.default_rng(seed)
41:    t_ref = t_sol = 0.0
42:    for _ in range(n):
43:        g = random_endgame(rng, max_empty)
44:        t = time.perf_counter()
45:        v_ref = minimax_ref(g)
46:        t_ref += time.perf_counter() - t
47:        t = time.perf_counter()
48:        v_sol, nodes = solve(g.cells, g.macro, g.next_board, g.player)
49:        t_sol += time.perf_counter() - t
50:        assert v_ref == v_sol, (v_ref, v_sol, str(g))
51:    print(f"solver agrees with reference minimax on {n} endgames (<= {max_empty} empties): ref {t_ref:.1f}s, solver {t_sol:.3f}s")
52:
53:
54:def test_speed(seed=1):
55:    rng = np.random.default_rng(seed)
56:    for max_empty in (10, 12, 14, 16):
57:        times, nodes_all = [], []
58:        for _ in range(10):
59:            g = random_endgame(rng, max_empty)
60:            t = time.perf_counter()
61:            _, nodes = solve(g.cells, g.macro, g.next_board, g.player)
62:            times.append(time.perf_counter() - t)
63:            nodes_all.append(nodes)
64:        print(f"<= {max_empty} empties: median {np.median(times) * 1000:.1f} ms, max {max(times) * 1000:.0f} ms, median nodes {int(np.median(nodes_all))}, max nodes {max(nodes_all)}")
