79:    # ---- helpers -----------------------------------------------------------
80:    def _put_slot(self, mask, cells, macro, nb, player, done, winner, prior, logits, value) -> None:
81:        """Write the new node into slot self.slot_t (per game) where mask is set."""
82:        flat = self.idx * self.M + self.slot_t
83:        m1 = mask.unsqueeze(1)
